{
  "name": "dsh-enhanced-team-mode",
  "version": "0.1.0",
  "description": "Team mode coordination: inject the coordinator instruction once per independent root-session task.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --import ./test/fixtures/register-entry-loader.mjs --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "index.js",
    "src",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "package.json",
    "README.md",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xincy22/dsh-enhanced-team-mode.git"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
